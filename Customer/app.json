{
  "expo": {
    "name": "Laster",
    "slug": "Laster",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/laster-icon-transparent.png",
    "scheme": "laster",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.laster.customer",
      "adaptiveIcon": {
        "backgroundColor": "#263746",
        "foregroundImage": "./assets/images/laster-icon-transparent.png",
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": null,
          "enableGooglePay": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/laster-icon-transparent.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#263746",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
